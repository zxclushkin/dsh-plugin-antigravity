{
  "name": "dsh-plugin-antigravity",
  "version": "0.2.0",
  "description": "Google Antigravity model provider for DeepSeek Harness: a native LLM adapter that reuses the credentials of an installed Antigravity app (Gemini, Claude, GPT-OSS, image generation) without any local HTTP gateway.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src",
    "test",
    "README.md"
  ],
  "scripts": {
    "test": "node test/unit.mjs",
    "test:live": "node test/live.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "antigravity",
    "gemini",
    "claude",
    "llm-adapter",
    "native-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxclushkin/dsh-plugin-antigravity.git"
  },
  "homepage": "https://github.com/zxclushkin/dsh-plugin-antigravity#readme",
  "bugs": {
    "url": "https://github.com/zxclushkin/dsh-plugin-antigravity/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
