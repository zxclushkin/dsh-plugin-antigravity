{
  "name": "dsh-plugin-antigravity",
  "version": "0.6.1",
  "description": "Google Antigravity model provider for DeepSeek Harness: a native LLM adapter, a built-in image_generate tool and a settings GUI with account limits.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "src",
    "test",
    "README.md"
  ],
  "scripts": {
    "test": "node test/unit.mjs",
    "test:live": "node test/live.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "antigravity",
    "gemini",
    "claude",
    "llm-adapter",
    "native-plugin",
    "image-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxclushkin/dsh-plugin-antigravity.git"
  },
  "homepage": "https://github.com/zxclushkin/dsh-plugin-antigravity#readme",
  "bugs": {
    "url": "https://github.com/zxclushkin/dsh-plugin-antigravity/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
