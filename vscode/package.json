{
  "name": "antigravity-chat",
  "displayName": "Antigravity Models",
  "description": "Google Antigravity models in VS Code chat: Gemini, Claude and GPT-OSS from the Antigravity plan, no API key (reuses the installed Antigravity session).",
  "version": "0.1.0",
  "publisher": "zxclushkin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "gemini",
    "claude",
    "copilot",
    "chat",
    "byok",
    "language-model"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguageModelChatProvider:antigravity"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "antigravity",
        "displayName": "Antigravity"
      }
    ],
    "commands": [
      {
        "command": "antigravity.showStatus",
        "title": "Antigravity: Show account status"
      },
      {
        "command": "antigravity.refreshModels",
        "title": "Antigravity: Refresh model list"
      },
      {
        "command": "antigravity.showLog",
        "title": "Antigravity: Show log"
      }
    ],
    "configuration": {
      "title": "Antigravity",
      "properties": {
        "antigravity.showThinking": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Stream the model's reasoning into the answer. VS Code has no separate thinking block for extension providers, so it appears as plain text."
        },
        "antigravity.maxConcurrentRequests": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "How many Antigravity requests may run at once."
        },
        "antigravity.requestSpacingMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum gap between two Antigravity requests, in milliseconds."
        },
        "antigravity.upstreamHost": {
          "type": "string",
          "default": "",
          "description": "Override the Antigravity API host (advanced; leave empty for the default)."
        },
        "antigravity.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Verbosity of the Antigravity output channel."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node .tmp/unit.test.cjs",
    "test:live": "node esbuild.mjs --tests && node .tmp/live.test.cjs",
    "package": "node esbuild.mjs && vsce package --no-dependencies --out antigravity-chat.vsix",
    "vscode:prepublish": "node esbuild.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.144.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zxclushkin/dsh-plugin-antigravity.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/zxclushkin/dsh-plugin-antigravity/issues"
  },
  "homepage": "https://github.com/zxclushkin/dsh-plugin-antigravity/tree/main/vscode#readme",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  }
}
